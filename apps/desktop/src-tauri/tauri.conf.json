{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "team-hub",
  "version": "0.1.0",
  "identifier": "dev.team-hub.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1430",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../ui"
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../ui"
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "team-hub",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "deb", "rpm", "appimage"],
    "publisher": "team-hub",
    "copyright": "Copyright © 2026 the team-hub authors",
    "category": "DeveloperTool",
    "shortDescription": "Agent threads for the issues assigned to you in team-hub",
    "longDescription": "A developer's cockpit on top of a team-hub server. The issues assigned to you become agent threads: an AI agent works on an issue in a local clone of the repository, in a git working tree and branch of its own, and whatever should leave your computer (a comment, a status change, a push, a pull request) waits for your click. The same app is a runner for work delegated to an agent on the web. It needs a team-hub server, git, Node.js 22.18 or newer, and Claude Code signed in or an Anthropic API key.",
    "homepage": "https://github.com/jash90/team-hub",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "../sidecar/src": "sidecar/src",
      "../sidecar/package.json": "sidecar/package.json",
      "../sidecar/package-lock.json": "sidecar/package-lock.json",
      "../sidecar/node_modules": "sidecar/node_modules"
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "section": "devel",
        "recommends": ["git", "nodejs (>= 22.18)", "bubblewrap", "socat"]
      },
      "rpm": {
        "recommends": ["git", "bubblewrap", "socat"]
      }
    }
  }
}
