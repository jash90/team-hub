{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "team-hub",
  "version": "0.1.0",
  "identifier": "dev.team-hub.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1430",
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "beforeBuildCommand": "npm --prefix ../ui run build"
  },
  "app": {
    "windows": [{ "label": "main", "title": "team-hub", "width": 1440, "height": 900, "minWidth": 900, "minHeight": 560 }],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico", "icons/icon.png"],
    "resources": { "../sidecar/src": "sidecar/src", "../sidecar/package.json": "sidecar/package.json", "../sidecar/package-lock.json": "sidecar/package-lock.json", "../sidecar/node_modules": "sidecar/node_modules" }
  }
}
